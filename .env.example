# ==============================================================================
# ASYS Intelligence Platform - Environment Configuration Example
# ==============================================================================

# AI Studio & Platform Secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost"

# Application Environment
ENVIRONMENT=production
SECRET_KEY="change-this-super-secret-key-in-production"

# Frontend Configuration
VITE_API_BASE_URL="/api"

# Database Credentials (PostgreSQL)
POSTGRES_SERVER=postgres
POSTGRES_USER=asys_user
POSTGRES_PASSWORD=asys_secret_password
POSTGRES_DB=asys_platform_db
POSTGRES_PORT=5432

# Cache & Messaging (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
